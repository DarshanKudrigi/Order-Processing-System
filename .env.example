ENVIRONMENT=development
PORT=8080
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/orders
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/orders
JWT_SECRET=change-me-long-random-secret-key-at-least-32-chars
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173
SERVICEBUS_CONNECTION_STRING=Endpoint=sb://mock-servicebus.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=mockkey
SB_TOPIC_NAME=order-events
SB_MAX_CONCURRENT_CALLS=5
SENDGRID_API_KEY=
MAIL_FROM=orders@example.com
APPLICATIONINSIGHTS_CONNECTION_STRING=
USE_IN_MEMORY_BUS=true

